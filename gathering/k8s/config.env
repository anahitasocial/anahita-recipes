# The site's settings, each with why. anahita-services' docs/configuration.md
# describes every setting there is; what is not here keeps its default.
# Passwords and keys go in secrets.env. `make init` fills in the domain and
# the addresses; the rest are the gathering recipe's choices, yours to change.

# The site. The web app is at https://example.org, the API at
# api.example.org, sign-in at auth.example.org, files at files.example.org.
DOMAIN_NAME=example.org
SITE_NAME=Example
# A sentence about the site, on its home page and to other servers.
ANAHITA_INSTANCE_DESCRIPTION=
# The logo on the sign-in pages, in every email, and on the web app's home
# page and menu, served by the web app (web/build.sh puts it there). Leave
# it out to show Anahita's.
SITE_LOGO_URL=https://example.org/logo.png
OAUTH_ISSUER=https://auth.example.org
WEB_ORIGIN=https://example.org
PUBLIC_WEB_URL=https://example.org

# Who may join. approval: anybody may ask, and an administrator says yes,
# so that a new site is not filled by strangers before its first rules are
# written. open lets anybody in; invite, only those an administrator
# invites; closed, nobody, and it stops invitations already sent.
REGISTRATION_MODE=approval

# What somebody not signed in may read. public: what is public, as on
# Mastodon. registered makes a site for its members only, as a school or a
# company may need; preview shows only the start of each post.
SITE_READ_ACCESS=public

# The first super administrator, made at the first start. The link to set a
# password is mailed, and written to auth-service's log.
SUPER_ADMIN_EMAIL=admin@example.org

# The fediverse, both networks: people on Mastodon, Pixelfed and Bluesky can
# follow and reply. Each profile still chooses whether it federates.
FEDERATION_PROTOCOLS=activitypub,atproto

# No videos, GIFs or sound: a gathering's instance.json leaves video-service
# out. Said here too, so that nothing offers them while the file is being
# changed.
VIDEO_UPLOADS=off
AUDIO_UPLOADS=off
AUDIO_RECORDING=off

# The files, in Garage on this server, reached from inside at garage:3900
# and by browsers at files.example.org. For a provider's S3 store instead,
# see the README.
STORAGE_ENDPOINT=http://garage:3900
STORAGE_PUBLIC_ENDPOINT=https://files.example.org
STORAGE_REGION=garage
STORAGE_BUCKET=anahita
STORAGE_PATH_STYLE=true

# Every night, stored files that nothing names any more are removed. off
# would only count them, in the sweep's log.
FILE_SWEEP=on

# Outgoing mail: the codes to sign in, invitations, notices. From your mail
# provider, with the user name and password in secrets.env. 587 with
# SMTP_SECURE=false starts TLS after connecting; 465 with true begins with it.
SYSTEM_EMAIL=noreply@example.org
SUPPORT_EMAIL=support@example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false

# Sent to the public geocoders, whose usage policy asks for a contact.
GEOCODER_CONTACT=admin@example.org
