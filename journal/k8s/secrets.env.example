# `make init` copies this to secrets.env, which git ignores, and puts a key
# it makes in place of every CHANGE_ME. Keep a copy of secrets.env somewhere
# safe, CRYPT_LOCAL_KEY above all: without it nobody can sign in.

# The database account. DSN repeats the user and password, for the services;
# the MYSQL_ entries are for the migration job and the MySQL component.
MYSQL_USER=anahita
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
DSN=anahita:CHANGE_ME@(mysql:3306)/anahita?parseTime=true

# The event bus account. AMQP_ADDR repeats it.
RABBITMQ_USER=anahita
RABBITMQ_PASSWORD=CHANGE_ME
AMQP_ADDR=amqp://anahita:CHANGE_ME@rabbitmq:5672

# Empty: the Redis on this server has no password, and nothing outside it
# can reach it.
REDIS_PASSWORD=

# Signs session cookies. 32 characters.
SECURE_COOKIE_KEY=CHANGE_ME
# Seals two-factor secrets and the token signing key. 32 characters.
CRYPT_LOCAL_KEY=CHANGE_ME

# Garage: its RPC secret (64 hex characters) and its admin token.
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
# The key the services use for the files, which garage-init gives Garage:
# GK and 24 hex characters, and 64 hex characters.
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME

# Your mail provider's user name and password, which `make init` asks for.
# Empty for a relay that needs no sign-in.
SMTP_USER=
SMTP_PASSWORD=
